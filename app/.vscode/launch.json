{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Next.js: Server (Node)",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "dev", "--", "--inspect"],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "restart": true,
            "skipFiles": ["<node_internals>/**"]
        },
        {
            "name": "Next.js: Client (Chrome)",
            "type": "pwa-chrome",
            "request": "launch",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}",
            "sourceMaps": true
        }
    ]
}